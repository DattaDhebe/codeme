{
  "name": "personal-codeme",
  "displayName": "CodeMe",
  "publisher": "personal-codex-local",
  "description": "CodeMe by DHEBE Studios: local coding models, reviewable edits, durable tasks and approved checks in VS Code.",
  "repository": {
    "type": "git",
    "url": "https://github.com/DattaDhebe/codeme.git",
    "directory": "vscode-extension"
  },
  "license": "MIT",
  "version": "0.7.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onCommand:personalCodeme.openChat",
    "onCommand:personalCodex.newChat",
    "onCommand:personalCodex.explainSelection",
    "onCommand:personalCodex.fixSelection",
    "onCommand:personalCodex.refactorSelection",
    "onCommand:personalCodex.generateTests",
    "onCommand:personalCodex.askCurrentFile",
    "onCommand:personalCodex.reviewChanges",
    "onCommand:personalCodex.registerWorkspace",
    "onCommand:personalCodex.checkBackend",
    "onCommand:personalCodex.startBackend",
    "onView:personalCodemeSidebar"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build:extension": "esbuild src/extension.ts --bundle --platform=node --target=node18 --outfile=dist/extension.js --external:vscode --sourcemap",
    "build:webview": "esbuild src/webview/webview.ts --bundle --platform=browser --target=es2020 --outfile=dist/webview.js --sourcemap --minify",
    "build": "npm run build:notices && npm run build:extension && npm run build:webview",
    "watch:extension": "esbuild src/extension.ts --bundle --platform=node --target=node18 --outfile=dist/extension.js --external:vscode --watch",
    "watch:webview": "esbuild src/webview/webview.ts --bundle --platform=browser --target=es2020 --outfile=dist/webview.js --watch",
    "watch": "npm-run-all --parallel watch:extension watch:webview",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mjs",
    "test:integration": "node ./scripts/native-test-runner.cjs",
    "package": "vsce package --out personal-codeme-0.7.0.vsix --baseContentUrl https://github.com/DattaDhebe/codeme/blob/main/vscode-extension/ --baseImagesUrl https://raw.githubusercontent.com/DattaDhebe/codeme/main/vscode-extension/",
    "prepackage": "npm run build:notices",
    "build:notices": "node ./scripts/build-notices.cjs"
  },
  "files": [
    "dist/extension.js",
    "dist/webview.js",
    "media/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^2.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.5.4",
    "vitest": "^5.0.5",
    "@vscode/vsce": "^4.1.0"
  },
  "dependencies": {
    "marked": "^18.1.2",
    "prismjs": "^1.30.0"
  },
  "contributes": {
    "configuration": {
      "title": "CodeMe",
      "properties": {
        "personalCodex.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Local CodeMe backend URL."
        },
        "personalCodex.defaultModel": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Default local model requested by CodeMe."
        },
        "personalCodex.autoRegisterWorkspace": {
          "type": "boolean",
          "default": false,
          "description": "Ask before registering an opened workspace folder with CodeMe."
        },
        "personalCodex.requireWriteApproval": {
          "type": "boolean",
          "default": true,
          "description": "Require user approval for write or tool-execution actions."
        },
        "personalCodex.enableUnsafeCommandExecution": {
          "type": "boolean",
          "default": false,
          "description": "Deprecated compatibility setting. Raw command proposals are display-only and cannot bypass the controlled runner.",
          "deprecationMessage": "Deprecated: raw command proposals are display-only. Use structured controlled command profiles."
        },
        "personalCodex.pythonExecutable": {
          "type": "string",
          "default": "python",
          "description": "User-controlled trusted Python executable name for pytest and python_module profiles."
        },
        "personalCodex.npmExecutable": {
          "type": "string",
          "default": "npm",
          "description": "User-controlled trusted npm wrapper for controlled npm profiles."
        },
        "personalCodex.dotnetExecutable": {
          "type": "string",
          "default": "dotnet",
          "description": "User-controlled trusted dotnet executable for controlled .NET profiles."
        },
        "personalCodex.mavenExecutable": {
          "type": "string",
          "default": "mvn",
          "description": "User-controlled trusted Maven wrapper for controlled Maven profiles."
        },
        "personalCodex.gradleExecutable": {
          "type": "string",
          "default": "gradle",
          "description": "User-controlled trusted Gradle wrapper for controlled Gradle profiles."
        },
        "personalCodex.gitExecutable": {
          "type": "string",
          "default": "git",
          "description": "User-controlled trusted Git executable for read-only status and diff profiles."
        },
        "personalCodex.customExecutableAllowlist": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Explicit user-owned alias-to-executable allowlist. Repository content cannot modify it."
        },
        "personalCodex.commandOutputLimitBytes": {
          "type": "number",
          "default": 1048576,
          "minimum": 16384,
          "maximum": 4194304,
          "description": "Maximum command output streamed into the sidebar; pipes continue to be drained after this cap."
        },
        "personalCodex.commandTailLimitBytes": {
          "type": "number",
          "default": 65536,
          "minimum": 8192,
          "maximum": 65536,
          "description": "Maximum bounded stdout and stderr tail retained for durable results."
        },
        "personalCodex.verificationMaximumRepairAttempts": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 2,
          "description": "Maximum proposed repair attempts in one approved bounded verification session."
        },
        "personalCodex.verificationMaximumReruns": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 2,
          "description": "Maximum exact-plan reruns after approved repairs."
        },
        "personalCodex.verificationTimeBudgetSeconds": {
          "type": "number",
          "default": 600,
          "minimum": 30,
          "maximum": 1200,
          "description": "Total wall-clock budget for one verification and repair session."
        },
        "personalCodex.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeMe notifications for backend status and workspace actions."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "personalCodeme",
          "title": "CodeMe",
          "icon": "media/codeme-activity.svg"
        }
      ]
    },
    "views": {
      "personalCodeme": [
        {
          "id": "personalCodemeSidebar",
          "name": "CodeMe",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "personalCodeme.openChat",
        "title": "CodeMe: Open Chat"
      },
      {
        "command": "personalCodex.newChat",
        "title": "CodeMe: New Chat"
      },
      {
        "command": "personalCodex.explainSelection",
        "title": "CodeMe: Explain Selected Code"
      },
      {
        "command": "personalCodex.fixSelection",
        "title": "CodeMe: Fix Selected Code"
      },
      {
        "command": "personalCodex.refactorSelection",
        "title": "CodeMe: Refactor Selected Code"
      },
      {
        "command": "personalCodex.generateTests",
        "title": "CodeMe: Generate Tests"
      },
      {
        "command": "personalCodex.askCurrentFile",
        "title": "CodeMe: Ask About Current File"
      },
      {
        "command": "personalCodex.reviewChanges",
        "title": "CodeMe: Review Current Changes"
      },
      {
        "command": "personalCodex.registerWorkspace",
        "title": "CodeMe: Register Workspace"
      },
      {
        "command": "personalCodex.checkBackend",
        "title": "CodeMe: Check Backend Connection"
      },
      {
        "command": "personalCodex.startBackend",
        "title": "CodeMe: Start Local Backend"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "personalCodeme.openChat"
        },
        {
          "command": "personalCodex.newChat"
        },
        {
          "command": "personalCodex.explainSelection"
        },
        {
          "command": "personalCodex.fixSelection"
        },
        {
          "command": "personalCodex.refactorSelection"
        },
        {
          "command": "personalCodex.generateTests"
        },
        {
          "command": "personalCodex.askCurrentFile"
        },
        {
          "command": "personalCodex.reviewChanges"
        },
        {
          "command": "personalCodex.registerWorkspace"
        },
        {
          "command": "personalCodex.checkBackend"
        },
        {
          "command": "personalCodex.startBackend"
        }
      ],
      "editor/context": [
        {
          "command": "personalCodex.explainSelection",
          "when": "editorHasSelection",
          "group": "navigation"
        },
        {
          "command": "personalCodex.fixSelection",
          "when": "editorHasSelection",
          "group": "navigation"
        },
        {
          "command": "personalCodex.refactorSelection",
          "when": "editorHasSelection",
          "group": "navigation"
        },
        {
          "command": "personalCodex.generateTests",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    }
  },
  "homepage": "https://www.dhebe.com/",
  "bugs": {
    "url": "https://github.com/DattaDhebe/codeme/issues"
  },
  "author": {
    "name": "DattaDhebe",
    "url": "https://github.com/DattaDhebe"
  },
  "icon": "media/codeme.png",
  "keywords": [
    "codeme",
    "local-ai",
    "ollama",
    "coding-agent",
    "code-review",
    "local-models"
  ],
  "galleryBanner": {
    "color": "#111D32",
    "theme": "dark"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.12.0 || ^24.0.0 || >=26.0.0",
      "onFail": "error"
    }
  }
}
