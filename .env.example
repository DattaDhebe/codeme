# Local backend. Restart CodeMe after editing this file.
APP_NAME=Personal Codex
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]
DATABASE_URL=sqlite:///./codeme.db

# Ollama is the automatic-setup path. Existing suitable models are reused.
MODEL_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
DEFAULT_MODEL=qwen2.5-coder:7b
AUTO_MODEL_SETUP=true
OLLAMA_CONTEXT_LENGTH=8192

# Used only when MODEL_PROVIDER=openai_compatible.
# Start a trusted local-only server and load a model there first.
LOCAL_MODEL_URL=http://127.0.0.1:1234/v1

# Coding tasks pause for review; waiting does not consume active model time.
AGENT_MAX_CYCLES=8
AGENT_TIME_BUDGET_SECONDS=900
DEFAULT_WORKSPACE_ROOT=.
ALLOW_UNC_PATHS=false
MAX_FILE_SIZE=1500000
