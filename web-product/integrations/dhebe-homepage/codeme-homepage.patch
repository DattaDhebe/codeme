+import { UiIcon } from './ui-icon';
+import styles from './codeme-product-section.module.css';
+
+export function CodeMeProductSection() {
+  return (
+    <section id="codeme" className={`content-container ${styles.section}`} aria-labelledby="codeme-title">
+      <div className="section-heading">
+        <div><p className="eyebrow">SOFTWARE FOR YOUR OWN MACHINE</p><h2 id="codeme-title">Meet CodeMe.</h2></div>
+        <p>A coding assistant with local model inference.<br />Built by DHEBE Studios.</p>
+      </div>
+      <article className={styles.card}>
+        <div className={styles.identity}>
+          <img src="/products/codeme/assets/codeme-logo.svg" alt="CodeMe logo" width={80} height={80} loading="lazy" />
+          <span>LOCAL CODING AGENT</span>
+        </div>
+        <div className={styles.copy}>
+          <h3>From a task to a working change.</h3>
+          <p>Inspect a repository, plan a change, review edits and run approved commands with a model running on your computer.</p>
+          <ul><li>Ollama or a compatible local server</li><li>Automatic model setup with progress</li><li>Browser app and VS Code extension</li></ul>
+          <p className={styles.requirements}>Requires Python 3.10+ and Node.js/npm. Initial setup needs internet access; model downloads can be several GB. Performance depends on your hardware.</p>
+        </div>
+        <div className={styles.purchase}>
+          <p className={styles.price}>₹499<span>one-time packaged download</span></p>
+          <a className="button-primary" href="https://www.dhebe.com/products/codeme/" data-product-id="codeme">Explore CodeMe<UiIcon name="arrow" width="18" height="18" /></a>
+          <p>Read the requirements before buying.<br />Download unlocks after verified payment.</p>
+        </div>
+      </article>
+    </section>
+  );
+}
