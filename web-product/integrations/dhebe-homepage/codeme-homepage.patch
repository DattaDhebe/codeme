+++ b/components/codeme-product-section.module.css
@@ -0,0 +1,30 @@
+.section { padding-block: 38px 56px; }
+.card { display: grid; grid-template-columns: 112px minmax(0, 1fr) 230px; align-items: center; gap: 30px; padding: 32px; border: 1px solid var(--app-card-border); border-radius: 18px; background: var(--app-card); box-shadow: var(--app-shadow); }
+.identity { display: flex; flex-direction: column; align-items: center; gap: 16px; }
+.identity img { width: 80px; height: 80px; border-radius: 18px; }
+.identity span { color: var(--app-muted); font-size: 9px; line-height: 1.7; letter-spacing: .1em; text-align: center; font-weight: 700; }
+.copy h3 { margin: 0 0 10px; color: var(--app-title); font-size: clamp(22px, 2.2vw, 29px); line-height: 1.25; }
+.copy p { margin: 0; color: var(--app-muted); font-size: 14px; line-height: 1.75; }
+.copy ul { display: flex; flex-wrap: wrap; gap: 8px 18px; padding-left: 17px; margin: 17px 0; color: var(--app-text); font-size: 12px; line-height: 1.6; }
+.copy p.requirements { font-size: 11px; line-height: 1.7; }
+.purchase { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; padding-left: 26px; border-left: 1px solid var(--app-card-border); }
+.purchase p { margin: 0; color: var(--app-muted); font-size: 11px; line-height: 1.65; }
+.purchase p.price { color: var(--app-title); font-family: var(--font-display); font-size: 38px; font-weight: 700; line-height: 1; }
+.price span { display: block; margin-top: 10px; color: var(--app-muted); font-family: var(--font-sans); font-size: 11px; font-weight: 400; line-height: 1.5; }
+.purchase a { white-space: nowrap; }
+@media (max-width: 900px) {
+  .card { grid-template-columns: 86px minmax(0, 1fr); gap: 22px; padding: 26px; }
+  .purchase { grid-column: 2; border-left: 0; padding: 18px 0 0; border-top: 1px solid var(--app-card-border); }
+  .identity { align-self: start; }
+}
+@media (max-width: 560px) {
+  .section { padding-block: 26px 40px; }
+  .card { grid-template-columns: minmax(0, 1fr); gap: 22px; padding: 22px; }
+  .identity { flex-direction: row; justify-content: flex-start; }
+  .identity img { width: 56px; height: 56px; border-radius: 12px; }
+  .identity span { text-align: left; }
+  .purchase { grid-column: 1; align-items: stretch; }
+  .purchase a { justify-content: center; }
+  .copy ul { display: block; }
+  .copy li + li { margin-top: 7px; }
+}
